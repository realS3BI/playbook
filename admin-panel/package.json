{
  "name": "playbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "pnpm run build:server && pnpm run build:client",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "node ../dev.mjs --port 5457",
    "dev:client": "vite --config client/vite.config.ts",
    "start": "node build/src/server.js",
    "test": "pnpm run build:server && node --test \"build/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@laihoe/demoparser2": "0.42.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@shadcn/react": "^0.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "1.4.7",
    "express": "^4.22.1",
    "express-rate-limit": "7.5.0",
    "globaloffensive": "3.3.0",
    "globaloffensive-sharecode": "1.1.1",
    "hash-wasm": "^4.12.0",
    "libarchive.js": "^2.0.2",
    "lucide-react": "^0.562.0",
    "meshoptimizer": "^1.3.0",
    "mongodb": "6.13.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.20.1",
    "sharp": "^0.35.5",
    "steam-user": "5.3.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^7.7.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vite": "^7.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/realS3BI/playbook.git",
    "directory": "admin-panel"
  },
  "homepage": "https://github.com/realS3BI/playbook#readme",
  "bugs": {
    "url": "https://github.com/realS3BI/playbook/issues"
  },
  "description": "Playbook für CS2: Lineup-Bibliothek, Training, Reviews und Serververwaltung"
}
