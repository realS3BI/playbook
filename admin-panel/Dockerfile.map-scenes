# Exports CS2 maps for the Abwurfsicht. Source 2 Viewer ships glibc builds only, so this worker uses Debian.
FROM node:22-bookworm-slim

ARG TARGETARCH
ARG SOURCE2VIEWER_VERSION=20.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip libicu72 libfontconfig1 \
 && case "$TARGETARCH" in \
      amd64) asset=cli-linux-x64.zip; sum=3e8af47cd6ce52e8068904f2aa1dda23c56a6b96a8310b25090f0711cda76a8a ;; \
      arm64) asset=cli-linux-arm64.zip; sum=adcfeac823e25ebdaebe0b6c4b3132546afa3978d23fca37bb522da1fe5cb2e5 ;; \
      *) echo "Keine Source-2-Viewer-Version für $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/source2viewer.zip "https://github.com/ValveResourceFormat/ValveResourceFormat/releases/download/${SOURCE2VIEWER_VERSION}/${asset}" \
 && echo "$sum  /tmp/source2viewer.zip" | sha256sum -c - \
 && mkdir -p /opt/source2viewer \
 && unzip -q /tmp/source2viewer.zip -d /opt/source2viewer \
 && chmod +x /opt/source2viewer/Source2Viewer-CLI \
 && rm /tmp/source2viewer.zip \
 && apt-get purge -y curl unzip && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*
RUN corepack enable pnpm

WORKDIR /app
COPY admin-panel/package.json admin-panel/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY admin-panel/src ./src
COPY admin-panel/shared ./shared
COPY admin-panel/tsconfig.server.json admin-panel/tsconfig.worker.json ./
RUN pnpm exec tsc -p tsconfig.worker.json && pnpm prune --prod

# The root file system is read-only; .NET needs a writable home for its runtime files.
ENV NODE_ENV=production HOME=/tmp DOTNET_BUNDLE_EXTRACT_BASE_DIR=/tmp
CMD ["node", "build/src/map-scene-worker-main.js"]
