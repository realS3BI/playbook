<root>
    <styles><include src="s2r://panorama/styles/custom_game/playbook_training.vcss_c" /></styles>
    <Panel class="training-screen" hittest="false">
        <Panel id="training_panel" class="training-panel" hittest="true">
            <Panel id="training_rail" class="rail" />
            <Panel class="heading">
                <Panel class="brandline">
                    <Label class="brand" text="PLAYBOOK" />
                    <Label id="training_map" class="map" text="{s:text}" />
                    <Panel class="focus-dot" />
                    <Label id="training_focus" class="focus" text="{s:text}" />
                </Panel>
                <Label id="training_title" class="title" text="{s:text}" />
                <Label id="training_breadcrumb" class="breadcrumb" text="{s:text}" />
            </Panel>
            <Panel class="rows">
                <Button id="row_0" class="row"><Panel class="kind" /><Label id="row_0_text" class="name" text="{s:text}" /><Label id="row_0_meta" class="meta" text="{s:text}" /><Label id="row_0_state" class="state" text="{s:text}" /><Button id="row_0_fav" class="fav"><Label id="row_0_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_1" class="row"><Panel class="kind" /><Label id="row_1_text" class="name" text="{s:text}" /><Label id="row_1_meta" class="meta" text="{s:text}" /><Label id="row_1_state" class="state" text="{s:text}" /><Button id="row_1_fav" class="fav"><Label id="row_1_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_2" class="row"><Panel class="kind" /><Label id="row_2_text" class="name" text="{s:text}" /><Label id="row_2_meta" class="meta" text="{s:text}" /><Label id="row_2_state" class="state" text="{s:text}" /><Button id="row_2_fav" class="fav"><Label id="row_2_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_3" class="row"><Panel class="kind" /><Label id="row_3_text" class="name" text="{s:text}" /><Label id="row_3_meta" class="meta" text="{s:text}" /><Label id="row_3_state" class="state" text="{s:text}" /><Button id="row_3_fav" class="fav"><Label id="row_3_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_4" class="row"><Panel class="kind" /><Label id="row_4_text" class="name" text="{s:text}" /><Label id="row_4_meta" class="meta" text="{s:text}" /><Label id="row_4_state" class="state" text="{s:text}" /><Button id="row_4_fav" class="fav"><Label id="row_4_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_5" class="row"><Panel class="kind" /><Label id="row_5_text" class="name" text="{s:text}" /><Label id="row_5_meta" class="meta" text="{s:text}" /><Label id="row_5_state" class="state" text="{s:text}" /><Button id="row_5_fav" class="fav"><Label id="row_5_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_6" class="row"><Panel class="kind" /><Label id="row_6_text" class="name" text="{s:text}" /><Label id="row_6_meta" class="meta" text="{s:text}" /><Label id="row_6_state" class="state" text="{s:text}" /><Button id="row_6_fav" class="fav"><Label id="row_6_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_7" class="row"><Panel class="kind" /><Label id="row_7_text" class="name" text="{s:text}" /><Label id="row_7_meta" class="meta" text="{s:text}" /><Label id="row_7_state" class="state" text="{s:text}" /><Button id="row_7_fav" class="fav"><Label id="row_7_fav_text" text="{s:text}" /></Button></Button>
                <Button id="row_8" class="row"><Panel class="kind" /><Label id="row_8_text" class="name" text="{s:text}" /><Label id="row_8_meta" class="meta" text="{s:text}" /><Label id="row_8_state" class="state" text="{s:text}" /><Button id="row_8_fav" class="fav"><Label id="row_8_fav_text" text="{s:text}" /></Button></Button>
            </Panel>
            <Panel class="navigation">
                <Button id="training_back" class="small-button"><Label text="‹ Zurück" /></Button>
                <Button id="training_previous" class="small-button"><Label text="‹ Seite" /></Button>
                <Panel id="training_pages" class="pages">
                    <Label id="training_page" class="page-number" text="{s:text}" />
                    <Panel class="page-dots">
                        <Panel id="page_dot_0" class="dot" />
                        <Panel id="page_dot_1" class="dot" />
                        <Panel id="page_dot_2" class="dot" />
                        <Panel id="page_dot_3" class="dot" />
                        <Panel id="page_dot_4" class="dot" />
                    </Panel>
                </Panel>
                <Button id="training_next" class="small-button"><Label text="Seite ›" /></Button>
                <Button id="training_home" class="small-button"><Label text="⌂ Home" /></Button>
            </Panel>
            <Panel class="details">
                <Label id="training_status" class="status" text="{s:text}" />
                <Panel id="training_progress" class="progress"><Panel id="training_progress_fill" class="progress-fill" /></Panel>
                <Label id="training_detail" class="description" text="{s:text}" />
            </Panel>
        </Panel>
    </Panel>
</root>
